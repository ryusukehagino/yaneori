---
/**
 * ランダム日付YouTube検索
 */
import {IMG_PATH} from '../consts.js';
import Layout from '@layouts/Layout.astro';
import ContentsBox from '@layouts/ContentsBox.astro';
import Title from '@components/Title.astro';
import Btn from '@components/Btn.astro';

const meta = {
	title: 'ランダム日付YouTube検索',
	description: 'キーワード指定+ランダム日付でYouTube動画を検索。',
}
---

<Layout title={meta.title} description={meta.description}>
	<ContentsBox>
		<section class="section">
			<Title addClass="is_center">
				<Fragment slot="default">ランダム日付YouTube検索</Fragment><br>
				<Fragment name="sub">/ Random Date YouTube Search</Fragment>
			</Title>
			<p class="section_text">
				キーワード指定+ランダム日付でYouTube動画を検索。<br>
				Search with keywords and random date.
			</p>
			<form action="" class="form">
				<div class="form_row">
					<label for="keyword" class="form_label">キーワード / keywords</label>
					<input id="keyword" class="form_input" type="text" value="オリジナル曲">
				</div>
				<div class="form_row">
					<label for="lower_date" class="form_label">日付の下限 / lower date</label>
					<input id="lower_date" class="form_input" type="date" name="date" value="2007-06-19">
				</div>
				<div class="form_row">
					<label for="upper_date" class="form_label">日付の上限 / upper date</label>
					<input id="upper_date" class="form_input" type="date" name="date" value="">
				</div>
				<div class="form_btn">
					<Btn addClass="js_btn" href="https://">検索 / search</Btn>
					<!-- <div class="js_btn">検索</div> -->
				</div>
			</form>
		</section>
		<!-- /.section -->
	</ContentsBox>
</Layout>

<style lang="scss">
.section {
	&_text {
		margin-top: min(g.get_vw(20), 50px);
	}
}

.form {
	margin-top: min(g.get_vw(20), 50px);

	&_row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 5px;
		margin-top: 20px;
		padding-top: 20px;

		@include g.mq('md') {
			grid-template-columns: 200px 1fr;
			align-items: baseline;
		}

		&:not(:first-of-type) {
			border-top: 1px solid g.$color_border;
		}
	}

	&_input {
		width: 100%;
		height: 50px;
        padding: 10px;
        border: 1px solid g.$color_border;
        border-radius: 0;
		// background-color: g.$color_bg;
	}

	&_btn {
		display: flex;
		justify-content: center;
		margin-top: min(g.get_vw(20), 50px);
	}
}
</style>

<script>
import moment from 'moment';

const keyword = document.querySelector('#keyword');
const lowerDate = document.querySelector('#lower_date');
const upperDate = document.querySelector('#upper_date');
const btn = document.querySelector('.js_btn');

// 日付上限初期化（現在の日時を取得）
const m = moment();
upperDate.value = m.format('YYYY-MM-DD');

btn.addEventListener('click', (e) => {
	// 日付の下限～上限までの間でランダムな日付を生成
	const lower = moment(lowerDate.value);
	const upper = moment(upperDate.value);
	const diff = upper.diff(lower, 'd');
	const RandomDays = Math.floor(Math.random() * (diff + 1));

	// 検索文字列を生成
	const date1 = lower.add(RandomDays, 'd');
	const date2 = lower.clone().add(1, 'd');
	console.log(date1.format('YYYY-MM-DD'));
	console.log(date2.format('YYYY-MM-DD'));
	const query = `${keyword.value}+after%3A${date1.format('YYYY-MM-DD')}+before%3A${date2.format('YYYY-MM-DD')}`;
	const serchStr = `https://www.youtube.com/results?search_query=${query}`;
	// console.log(serchStr);

	e.target.href = serchStr;
});
</script>
