import {IMG_PATH} from '../../consts.js';
import Layout from '@layouts/Layout.astro';
import Mainvisual from '@components/Mainvisual.astro';
import ContentsBox from '@layouts/ContentsBox.astro';
import CategoryList from "@components/CategoryList.astro";
import ArticleList from "@components/ArticleList.astro";
import Btn from '@components/Btn.astro';
import {fetchBlogs, fetchBlogDetail} from "@scripts/microcms";



const categories = await fetchBlogs('works_category');
const parentCat = [];
for (let i = 0; i < categories.contents.length; i++) {
	const category = categories.contents[i];
	if (category.parent !== null) continue;
	parentCat.push({id: category.id, name: category.title})
}

const response = await fetchBlogs('works');

