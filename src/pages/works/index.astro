<script>
const catList = document.querySelectorAll('.js_category');
const articleList = document.querySelectorAll('.js_article');

// カテゴリにクリックイベントを追加
catList.forEach(cat => {
	cat.addEventListener('click', (e) => doWhenClickedCat(e));
});

/**
 * カテゴリをクリックしたら発火
 */
const doWhenClickedCat = (e) => {
	const target = e.target;
	const targetId = target.dataset.id;

	// クリックした要素にアクティブクラスを付与
	catList.forEach(cat => {
		cat.classList.remove('is_current');
	});
	target.classList.add('is_current');

	// クリックしたカテゴリ以外の記事を非表示
