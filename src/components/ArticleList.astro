---
/**
 * 記事リスト
 */
interface Post {
    href: string;
    img: string;
    title: string;
    text: string;
    date: string;
    categories: string[];
}

interface Props {
    posts: Post[];
    addClass?: string|string[];
}

const { posts = [], addClass = '' } = Astro.props;
---
<div class:list={['articleList', addClass]}>
    {posts.map((post) => (
        <a href={post.href} class="article" data-category={post.categories ? post.categories[0] : ''}>
            <figure class="article_img">
                <img src={post.img ? post.img : '/img/common/noimage.webp'} alt={post.title} width="" height="" />
            </figure>
            <dl class="article_textArea">
                <dt class="article_head">
                    <div class="article_title">{post.title}</div>
                    <div class="article_date">{post.date}</div>
                </dt>
                <dd class="article_body">{post.text}</dd>
            </dl>
            <ul class="article_categories">
                {() => {
                    if (post.categories) {
                        return (
                            post.categories.map((category) => (
                                <li>{category}</li>
                            ))
                        )
                    }
                }}
            </ul>
        </a>
    ))}
</div>


<style lang="scss">
.articleList {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.article {
    display: flex;
    flex-direction: column;
    padding: 10px 10px 20px;
    overflow: hidden;
    border-radius: 5px;
    box-shadow: 0 0 5px rgba(#000, 0.2);
    background-color: g.$color_white;

    &_img {
        overflow: hidden;

        img {
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
            transition: scale 0.3s;
        }
    }

    &:hover {
        &_img {
            img {
                scale: 1.05;
            }
        }
    }

    &_textArea {
        flex: 1;
        margin-top: 15px;
        padding-inline: 5px;
    }
    
    &_head {
        display: flex;
        align-items: baseline;
        gap: 1.2em;
    }
    
    &_title {
        font-size: min(g.get_vw(18), 2rem);
        font-weight: 500;
        line-height: 1.4;
    }

    &_date {
        font-size: 1.4rem;
    }
    
    &_body {
        margin-top: 10px;
        font-size: 1.4rem;
    }
    
    &_categories {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
        
        li {
            font-size: 1.2rem;
            padding: 0.2em 0.5em;
            border-radius: 5px;
            border: 1px solid g.$color_border;
        }
    }
}
</style>
